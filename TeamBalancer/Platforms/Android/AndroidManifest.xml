<?xml version="1.0" encoding="utf-8"?>
<!-- package, versionCode, versionName and label are deliberately absent: an explicit attribute
     here overrides the MSBuild property, which is what previously pinned every build to
     1.1/versionCode 2 no matter what the csproj said. They now come from ApplicationId,
     ApplicationVersion, ApplicationDisplayVersion and ApplicationTitle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:supportsRtl="true"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
</manifest>