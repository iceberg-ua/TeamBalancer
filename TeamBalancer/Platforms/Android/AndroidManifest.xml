<?xml version="1.0" encoding="utf-8"?>
<!-- package, versionCode, versionName and label are deliberately absent: an explicit attribute
     here overrides the MSBuild property, which is what previously pinned every build to
     1.1/versionCode 2 no matter what the csproj said. They now come from ApplicationId,
     ApplicationVersion, ApplicationDisplayVersion and ApplicationTitle. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:supportsRtl="true"></application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Scanning a shared squad from another phone's screen. Declared as not required so a
	     device without a camera can still install the app and use every other feature. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />
	<!-- Reading a shared squad from a QR code image the user was sent. Capped at API 32 on
	     purpose: from Android 13 the system photo picker hands back the one image the user
	     chose and needs no permission at all. The granular READ_MEDIA_IMAGES that would
	     replace it here is deliberately NOT declared - it grants the whole gallery, and it
	     puts the app under Google Play's Photo and Video Permissions policy, which is a
	     declaration form and a review for a feature that reads one picture. -->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
</manifest>