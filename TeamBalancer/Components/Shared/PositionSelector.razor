@using TeamBalancer.Core.Models
@using TeamBalancer.Extensions

<div class="position-selector flex-col">
    <div class="form-group flex-col">
        <label id="primaryPositionLabel">Primary Position</label>
        <div class="seg @(PrimaryPosition == Position.Unspecified ? "is-unset" : "")"
             role="group"
             aria-labelledby="primaryPositionLabel">
            @foreach (var position in PositionExtensions.SelectablePositions)
            {
                var option = position;
                <button type="button"
                        class="seg-opt @(PrimaryPosition == option ? "is-selected" : "")"
                        title="@option.ToDisplayName()"
                        aria-pressed="@(PrimaryPosition == option)"
                        @onclick="() => TogglePrimary(option)">
                    @option.ToAbbreviation()
                </button>
            }
        </div>
    </div>

    <div class="form-group flex-col">
        <label id="secondaryPositionLabel">Secondary Position (optional)</label>
        <div class="seg" role="group" aria-labelledby="secondaryPositionLabel">
            @foreach (var position in PositionExtensions.SelectablePositions.Where(p => p != PrimaryPosition))
            {
                var option = position;
                <button type="button"
                        class="seg-opt @(SecondaryPosition == option ? "is-selected" : "")"
                        title="@option.ToDisplayName()"
                        aria-pressed="@(SecondaryPosition == option)"
                        @onclick="() => ToggleSecondary(option)">
                    @option.ToAbbreviation()
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Position PrimaryPosition { get; set; } = Position.Unspecified;

    [Parameter]
    public EventCallback<Position> PrimaryPositionChanged { get; set; }

    [Parameter]
    public Position? SecondaryPosition { get; set; }

    [Parameter]
    public EventCallback<Position?> SecondaryPositionChanged { get; set; }

    /// <summary>
    /// Picks a primary position, or clears it when the already-selected option is tapped
    /// again - the segmented control has no separate "none" option to fall back to.
    /// </summary>
    private async Task TogglePrimary(Position position)
    {
        var primary = PrimaryPosition == position ? Position.Unspecified : position;

        PrimaryPosition = primary;
        await PrimaryPositionChanged.InvokeAsync(primary);

        // The secondary row never offers the current primary, but an already-chosen
        // secondary can collide with a newly picked primary. Drop it instead of leaving the
        // form in a combination the model would reject.
        if (SecondaryPosition.HasValue && SecondaryPosition.Value == primary)
        {
            SecondaryPosition = null;
            await SecondaryPositionChanged.InvokeAsync(null);
        }
    }

    /// <summary>
    /// Picks a secondary position, or clears it when the selected option is tapped again.
    /// </summary>
    private async Task ToggleSecondary(Position position)
    {
        var secondary = SecondaryPosition == position ? null : (Position?)position;

        SecondaryPosition = secondary;
        await SecondaryPositionChanged.InvokeAsync(secondary);
    }
}
