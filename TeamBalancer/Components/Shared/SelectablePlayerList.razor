@using TeamBalancer.Core.Localization
@using TeamBalancer.Core.Models
@using TeamBalancer.Extensions
@inject ILocalizationService Loc

@if (_openMenuPlayerId != null)
{
    <div class="menu-backdrop" @onclick="CloseAllMenus"></div>
}

<div class="player-list-container" @onclick="CloseAllMenus">
    @* The toolbar sits above the scroller rather than inside it: "Rating" is a heading for
       the column below it, so it has to hold its place while the rows move. *@
    <div class="list-toolbar" @onclick:stopPropagation="true">
        <button class="select-all" @onclick="ToggleSelectAll">
            <i class="fas fa-check-double"></i>
            <span>@(IsAllSelected ? Loc["playerList.deselectAll"] : Loc["playerList.selectAll"])</span>
        </button>
        <span class="toolbar-gap"></span>
        <span class="toolbar-rating">@Loc["playerList.headerRating"]</span>
        <span class="toolbar-check-spacer"></span>
        @if (ShowEditButton || ShowDeleteButton)
        {
            <span class="toolbar-actions-spacer"></span>
        }
    </div>

    <div class="player-list-scrollable scroll-shadows">
        <div class="player-list">
            @foreach (var player in Players)
            {
                var isSelected = SelectedPlayerIds.Contains(player.Id);
                var hasPosition = player.PrimaryPosition != Position.Unspecified;

                @* Tapping anywhere on the row includes or excludes the player. The check on
                   the right reports that state rather than being the only thing that sets it. *@
                <div class="player-row @(isSelected ? "is-selected" : "") @(_openMenuPlayerId == player.Id ? "menu-open" : "")"
                     @onclick="() => OnSelectionChanged(player.Id, !isSelected)">

                    <PositionChips Player="player" Dimmed="@(!isSelected)" />

                    <div class="row-identity">
                        <span class="row-name">@player.Name</span>
                        <span class="row-subline @(hasPosition ? "" : "is-unset")">
                            @(hasPosition ? player.PrimaryPosition.ToDisplayName(Loc) : Loc["playerItem.setPosition"])
                        </span>
                    </div>

                    <span class="row-rating"
                          title="@(Loc["playerItem.skillsTitle", player.Speed, player.TechnicalSkills, player.Stamina])">
                        <SkillRatingDisplay Rating="@((int)Math.Round(player.OverallSkillLevel, MidpointRounding.AwayFromZero))" />
                    </span>

                    <span class="row-check"><i class="fas fa-check"></i></span>

                    @if (ShowEditButton || ShowDeleteButton)
                    {
                        @* Editing and deleting a player live here because this is the only
                           screen that offers them. The menu swallows its own clicks so
                           reaching for it does not also toggle the row. *@
                        <div class="row-actions" @onclick:stopPropagation="true">
                            <button class="actions-menu-button"
                                    @onclick="() => HandleMenuToggle(player.Id, _openMenuPlayerId != player.Id)"
                                    title="@(Loc["playerItem.actionsTitle"])"
                                    aria-label="@(Loc["playerItem.actionsTitle"])">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>

                            @if (_openMenuPlayerId == player.Id)
                            {
                                <div class="actions-menu">
                                    @if (ShowEditButton)
                                    {
                                        <button class="row-menu-item edit-item" @onclick="() => HandleEdit(player)">
                                            <i class="fas fa-edit"></i>
                                            <span>@Loc["playerItem.edit"]</span>
                                        </button>
                                    }
                                    @if (ShowDeleteButton)
                                    {
                                        <button class="row-menu-item delete-item" @onclick="() => HandleDelete(player)">
                                            <i class="fas fa-trash"></i>
                                            <span>@Loc["playerItem.delete"]</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public List<Player> Players { get; set; } = [];

    [Parameter, EditorRequired]
    public HashSet<Guid> SelectedPlayerIds { get; set; } = [];

    [Parameter]
    public bool ShowEditButton { get; set; } = false;

    [Parameter]
    public bool ShowDeleteButton { get; set; } = false;

    [Parameter]
    public EventCallback<(Guid PlayerId, bool IsSelected)> OnPlayerSelectionChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnSelectAllPlayersChanged { get; set; }

    [Parameter]
    public EventCallback<Player> OnPlayerEdit { get; set; }

    [Parameter]
    public EventCallback<Player> OnPlayerDelete { get; set; }

    private Guid? _openMenuPlayerId = null;

    private bool IsAllSelected => Players.Any() && Players.All(p => SelectedPlayerIds.Contains(p.Id));

    private void HandleMenuToggle(Guid playerId, bool isOpen)
    {
        _openMenuPlayerId = isOpen ? playerId : null;
        StateHasChanged();
    }

    private void CloseAllMenus()
    {
        if (_openMenuPlayerId != null)
        {
            _openMenuPlayerId = null;
            StateHasChanged();
        }
    }

    private async Task OnSelectionChanged(Guid playerId, bool isSelected)
    {
        await OnPlayerSelectionChanged.InvokeAsync((playerId, isSelected));
    }

    /// <summary>
    /// Selects every player, or clears the selection when they are already all picked. The
    /// button reports which of the two it will do, so the one control covers both.
    /// </summary>
    private async Task ToggleSelectAll()
    {
        await OnSelectAllPlayersChanged.InvokeAsync(!IsAllSelected);
    }

    private async Task HandleEdit(Player player)
    {
        _openMenuPlayerId = null;
        await OnPlayerEdit.InvokeAsync(player);
    }

    private async Task HandleDelete(Player player)
    {
        _openMenuPlayerId = null;
        await OnPlayerDelete.InvokeAsync(player);
    }

    public void SelectAll()
    {
        foreach (var player in Players)
        {
            SelectedPlayerIds.Add(player.Id);
        }
    }

    public void DeselectAll()
    {
        SelectedPlayerIds.Clear();
    }
}
