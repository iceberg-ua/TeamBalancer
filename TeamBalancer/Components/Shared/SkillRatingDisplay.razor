<div class="skill-item">
    <span class="skill-icons">
        @for (int i = 1; i <= MaxRating; i++)
        {
            var zIndex = MaxRating - i + 1;
            var lightness = 48 + (i - 1) * 3;
            <i class="@(i <= Rating ? "fa-solid" : "fa-regular") fa-star skill-icon"
               style="--star-index: @zIndex; --star-color: hsl(45, 100%, @(lightness)%);"></i>
        }
    </span>
</div>

@code {
    [Parameter, EditorRequired]
    public int Rating { get; set; }

    [Parameter]
    public int MaxRating { get; set; } = 3;
}
