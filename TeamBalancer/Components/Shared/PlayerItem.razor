@using TeamBalancer.Core.Localization
@using TeamBalancer.Core.Models
@using TeamBalancer.Extensions
@inject ILocalizationService Loc

<div class="player-item @(IsMenuOpen ? "menu-open" : "")" @onclick="CloseMenu">
    <label class="player-checkbox">
        @if (ShowCheckbox)
        {
            <input type="checkbox"
                   checked="@IsSelected"
                   @onchange="@((e) => HandleSelectionChanged((bool)e.Value!))"
                   @onclick:stopPropagation="true" />
        }
        <div class="player-name">@Player.Name</div>
    </label>

    <div class="player-positions">
        @if (Player.PrimaryPosition == Position.Unspecified)
        {
            <span class="position-badge pos-unset" title="@(Loc["playerItem.noPositionTitle"])">
                <i class="fas fa-circle-question"></i>
                <span class="badge-text">@Loc["playerItem.setPosition"]</span>
            </span>
        }
        else
        {
            <span class="position-badge"
                  title="@(Loc["playerItem.primaryPositionTitle", Player.PrimaryPosition.ToDisplayName(Loc)])">
                @Player.PrimaryPosition.ToAbbreviation()
            </span>

            @if (Player.SecondaryPosition.HasValue)
            {
                <span class="position-badge is-secondary"
                      title="@(Loc["playerItem.secondaryPositionTitle", Player.SecondaryPosition.Value.ToDisplayName(Loc)])">
                    @Player.SecondaryPosition.Value.ToAbbreviation()
                </span>
            }
        }
    </div>

    @* One overall cluster stands in for the three skills the row used to list. The
       exact breakdown stays reachable as a tooltip. *@
    <div class="player-skills"
         title="@(Loc["playerItem.skillsTitle", Player.Speed, Player.TechnicalSkills, Player.Stamina])">
        <SkillRatingDisplay Rating="@((int)Math.Round(Player.OverallSkillLevel, MidpointRounding.AwayFromZero))" />
    </div>

    <div class="player-actions">
        @if (ShowEditButton || ShowDeleteButton)
        {
            <button class="actions-menu-button"
                    @onclick="ToggleMenu"
                    @onclick:stopPropagation="true"
                    title="@(Loc["playerItem.actionsTitle"])">
                <i class="fas fa-ellipsis-v"></i>
            </button>

            @if (IsMenuOpen)
            {
                <div class="actions-menu" @onclick:stopPropagation="true">
                    @if (ShowEditButton)
                    {
                        <button class="menu-item edit-item"
                                @onclick="HandleEdit"
                                @onclick:stopPropagation="true">
                            <i class="fas fa-edit"></i>
                            <span>@Loc["playerItem.edit"]</span>
                        </button>
                    }
                    @if (ShowDeleteButton)
                    {
                        <button class="menu-item delete-item"
                                @onclick="HandleDelete"
                                @onclick:stopPropagation="true">
                            <i class="fas fa-trash"></i>
                            <span>@Loc["playerItem.delete"]</span>
                        </button>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Player Player { get; set; } = null!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public bool ShowCheckbox { get; set; } = true;

    [Parameter]
    public bool ShowEditButton { get; set; } = false;

    [Parameter]
    public bool ShowDeleteButton { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OnSelectionChanged { get; set; }

    [Parameter]
    public EventCallback<Player> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Player> OnDelete { get; set; }

    [Parameter]
    public bool IsMenuOpen { get; set; }

    [Parameter]
    public EventCallback<bool> OnMenuToggle { get; set; }

    private async Task ToggleMenu()
    {
        await OnMenuToggle.InvokeAsync(!IsMenuOpen);
    }

    private async Task CloseMenu()
    {
        if (IsMenuOpen)
        {
            await OnMenuToggle.InvokeAsync(false);
        }
    }

    private async Task HandleSelectionChanged(bool isSelected)
    {
        await OnSelectionChanged.InvokeAsync(isSelected);
    }

    private async Task HandleEdit()
    {
        IsMenuOpen = false;
        await OnEdit.InvokeAsync(Player);
    }

    private async Task HandleDelete()
    {
        IsMenuOpen = false;
        await OnDelete.InvokeAsync(Player);
    }
}
