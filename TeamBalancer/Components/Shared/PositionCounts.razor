@using TeamBalancer.Core.Localization
@using TeamBalancer.Core.Models
@using TeamBalancer.Extensions
@inject ILocalizationService Loc

<div class="position-tiles">
    @foreach (var entry in GetSummary())
    {
        <div class="position-tile @(entry.Count == 0 ? "is-empty" : "")" title="@entry.Title">
            <span class="tile-count">@entry.Count</span>
            <span class="tile-label">@entry.Label</span>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the players to count - the squad the home screen summarises.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyCollection<Player> Players { get; set; } = [];

    /// <summary>
    /// Gets or sets whether players with no position get a tile of their own. A screen that
    /// names those players below the summary leaves it off, since the tile would only repeat
    /// what the rows already say; one that does not has to account for them somewhere.
    /// </summary>
    [Parameter]
    public bool ShowUnset { get; set; } = true;

    /// <summary>
    /// A single position count.
    /// </summary>
    private sealed record Entry(string Label, int Count, string Title);

    /// <summary>
    /// Counts the players by primary position. Every real position is returned even when its
    /// count is zero - a missing goalkeeper is exactly what this summary should reveal.
    /// </summary>
    private IEnumerable<Entry> GetSummary()
    {
        foreach (var position in PositionExtensions.SelectablePositions)
        {
            var count = Players.Count(p => p.PrimaryPosition == position);
            yield return new Entry(
                position.ToAbbreviation(),
                count,
                Loc["position.countTitle", count, position.ToDisplayName(Loc)]);
        }

        if (!ShowUnset)
        {
            yield break;
        }

        var unsetCount = Players.Count(p => p.PrimaryPosition == Position.Unspecified);
        if (unsetCount > 0)
        {
            yield return new Entry(
                Loc["position.unset"],
                unsetCount,
                Loc["position.unsetCountTitle", unsetCount]);
        }
    }
}
