@page "/"
@inherits LocalizedComponentBase
@using TeamBalancer.Core.Models
@using TeamBalancer.Components.Shared
@using TeamBalancer.Extensions

<LayoutSection Section="Header">
    <div class="header-with-menu">
        @* The language button takes the place the spacer used to hold, so the title stays
           centred between it and the menu button. *@
        <button class="menu-button" @onclick="ToggleLanguageMenu" title="@(Loc["language.title"])" aria-label="@(Loc["language.title"])">
            <i class="fas fa-globe"></i>
        </button>
        @* The active list's name sits under the title rather than replacing it: which squad
           is loaded is the second thing you need to know about this screen, not the first. *@
        <div class="header-title-block">
            <h1 class="header-title-centered">@Loc["app.title"]</h1>
            @* How big the squad is rides along with which squad it is - the name can be
               shortened to fit, the count never is. *@
            <button class="list-switcher" @onclick="ToggleListMenu" title="@(Loc["playerLists.switcher"])" aria-label="@(Loc["playerLists.switcher"])">
                <span class="list-switcher-name">@_activeListName</span>
                <span class="list-switcher-count">&#183; @Loc["playerList.playerCount", _players.Count]</span>
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
        <button class="menu-button" @onclick="ToggleMenu" title="@(Loc["common.menu"])">
            <i class="fas fa-ellipsis-v"></i>
        </button>
    </div>
</LayoutSection>

<LayoutSection Section="Footer">
    <div class="footer-buttons">
        <button class="btn btn-icon btn-secondary" @onclick="AddPlayer" title="@(Loc["home.addPlayer"])" aria-label="@(Loc["home.addPlayer"])">
            <i class="fas fa-plus"></i>
        </button>
        <button class="btn btn-success" @onclick="CreateTeams" disabled="@(!CanCreateTeams)">
            <i class="fas fa-shuffle create-icon"></i>
            @Loc["common.createTeams"]
        </button>
    </div>
</LayoutSection>

@if (_showLanguageMenu)
{
    <div class="menu-overlay menu-overlay-start" @onclick="ToggleLanguageMenu">
        <div class="menu-popup" @onclick:stopPropagation="true">
            <div class="menu-header">
                <h3>@Loc["language.title"]</h3>
                <button class="close-button" @onclick="ToggleLanguageMenu">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="menu-items">
                @foreach (var language in Loc.SupportedLanguages)
                {
                    var option = language;
                    var isCurrent = option.Code == Loc.CurrentLanguage;
                    <button class="menu-item @(isCurrent ? "is-selected" : "")" @onclick="() => SelectLanguage(option.Code)">
                        @* The tick shares the icon column with the other menus, so the rows
                           line up whether or not this is the active language. *@
                        <i class="fas @(isCurrent ? "fa-check" : "")"></i>
                        <span>@option.NativeName</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showListMenu)
{
    <div class="menu-overlay menu-overlay-center" @onclick="ToggleListMenu">
        <div class="menu-popup" @onclick:stopPropagation="true">
            <div class="menu-header">
                <h3>@Loc["playerLists.title"]</h3>
                <button class="close-button" @onclick="ToggleListMenu">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="menu-items">
                @foreach (var list in _lists)
                {
                    var option = list;
                    var isCurrent = option.Id == ActivePlayerRepository.CurrentListId;
                    <button class="menu-item @(isCurrent ? "is-selected" : "")" @onclick="() => SelectList(option.Id)">
                        @* The tick shares the icon column with the other menus, so the rows
                           line up whether or not this is the active list. *@
                        <i class="fas @(isCurrent ? "fa-check" : "")"></i>
                        <span>@option.Name</span>
                    </button>
                }
                <button class="menu-item menu-item-action" @onclick="GoToPlayerLists">
                    <i class="fas fa-sliders-h"></i>
                    <span>@Loc["playerLists.manage"]</span>
                </button>
            </div>
        </div>
    </div>
}

@if (_showMenu)
{
    <div class="menu-overlay" @onclick="ToggleMenu">
        <div class="menu-popup" @onclick:stopPropagation="true">
            <div class="menu-header">
                <h3>@Loc["common.menu"]</h3>
                <button class="close-button" @onclick="ToggleMenu">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="menu-items">
                <button class="menu-item" @onclick="ExportPlayers">
                    <i class="fas fa-upload"></i>
                    <span>@Loc["home.exportPlayers"]</span>
                </button>
                <label class="menu-item">
                    <i class="fas fa-download"></i>
                    <span>@Loc["home.importPlayers"]</span>
                    <InputFile OnChange="ImportPlayers" accept=".csv,text/csv,text/comma-separated-values,application/csv" style="display: none;" />
                </label>

                @* Sharing sits under the file actions it is a shortcut for: the same squad,
                   the same CSV, carried by a camera instead of a file. *@
                <div class="menu-divider"></div>

                <button class="menu-item" @onclick="ShowSquadQr">
                    <i class="fas fa-qrcode"></i>
                    <span>@Loc["share.showQr"]</span>
                </button>
                @if (QrScanner.IsCameraScanningSupported)
                {
                    <button class="menu-item" @onclick="ScanSquadQr">
                        <i class="fas fa-camera"></i>
                        <span>@Loc["share.scanQr"]</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showQrOverlay)
{
    <div class="confirm-overlay" @onclick="CloseQr">
        <div class="confirm-dialog qr-dialog" @onclick:stopPropagation="true">
            <div class="confirm-header">
                <h3>@Loc["share.showQr"]</h3>
            </div>
            <div class="confirm-body qr-body">
                @if (_qrImage is null)
                {
                    <p>@Loc["share.qrTooLarge", _players.Count]</p>
                }
                else
                {
                    <img class="qr-image" src="@_qrImage" alt="@Loc["share.qrAlt"]" />
                    <p class="qr-caption">@Loc["share.qrCaption", _activeListName, _players.Count]</p>
                }
            </div>
            <div class="confirm-footer">
                <button class="btn btn-secondary" @onclick="CloseQr">@Loc["common.close"]</button>
            </div>
        </div>
    </div>
}

@if (_showImportDialog)
{
    <div class="confirm-overlay" @onclick="CancelImport">
        <div class="confirm-dialog" @onclick:stopPropagation="true">
            <div class="confirm-header">
                <h3>@Loc["import.destinationTitle"]</h3>
            </div>
            <div class="confirm-body">
                <p>@Loc["import.destinationIntro", _pendingPlayerCount]</p>

                <div class="import-choice">
                    <label class="import-option @(_importCreatesNewList ? "is-selected" : "")">
                        <input type="radio" name="importTarget" checked="@_importCreatesNewList"
                               @onchange="() => SetImportTarget(true)" />
                        <span>@Loc["import.newList"]</span>
                    </label>

                    @if (_importCreatesNewList)
                    {
                        <div class="form-group flex-col import-detail">
                            <label for="importListName">@Loc["playerLists.nameLabel"]</label>
                            <input id="importListName"
                                   type="text"
                                   class="form-control @(_showImportNameError ? "is-invalid" : "")"
                                   @bind="_importListName"
                                   @bind:event="oninput"
                                   @bind:after="ValidateImportName"
                                   maxlength="@CsvSafeName.MaxLength"
                                   placeholder="@(Loc["playerLists.namePlaceholder"])" />
                            @if (_showImportNameError)
                            {
                                <div class="invalid-feedback">
                                    @Loc["playerLists.nameInvalid", CsvSafeName.MaxLength]
                                </div>
                            }
                        </div>
                    }

                    <label class="import-option @(!_importCreatesNewList ? "is-selected" : "")">
                        <input type="radio" name="importTarget" checked="@(!_importCreatesNewList)"
                               @onchange="() => SetImportTarget(false)" />
                        <span>@Loc["import.existingList"]</span>
                    </label>

                    @if (!_importCreatesNewList)
                    {
                        <div class="form-group flex-col import-detail">
                            <select class="form-control" @bind="_importTargetListId">
                                @foreach (var list in _lists)
                                {
                                    <option value="@list.Id">@list.Name</option>
                                }
                            </select>
                            @* Says plainly what a merge does before it runs, because "update"
                               could just as easily mean "replace" to someone reading it. *@
                            <p class="import-hint">@Loc["import.mergeHint"]</p>
                        </div>
                    }
                </div>
            </div>
            <div class="confirm-footer">
                <button class="btn btn-secondary" @onclick="CancelImport">@Loc["common.cancel"]</button>
                <button class="btn btn-primary" @onclick="ConfirmImport" disabled="@(!CanConfirmImport)">
                    @Loc["import.confirm"]
                </button>
            </div>
        </div>
    </div>
}

<div class="index-container">
    <div class="index-content">
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success")">
                @_message
            </div>
        }

        @* The squad the active list holds, summarised by position and then named player by
           player. It replaces the decorative pitch that used to fill this screen: what you
           want to know before pressing Create Teams is who is in the list. *@
        <PositionCounts Players="_players" ShowUnset="false" />

        @if (_players.Count == 0)
        {
            <div class="home-empty">
                <i class="fas fa-user-plus"></i>
                <p>@Loc["home.empty"]</p>
            </div>
        }
        else
        {
            <div class="home-roster-scroll scroll-shadows">
                <div class="home-roster">
                    @foreach (var player in _players)
                    {
                        var hasPosition = player.PrimaryPosition != Position.Unspecified;

                        @* The whole row is the tap target: from here a player is opened to be
                           edited, which is the only thing there is to do with one on this
                           screen. *@
                        <button type="button" class="roster-row"
                                @onclick="() => EditPlayer(player)"
                                title="@(Loc["playerItem.edit"])">
                            <PositionChips Player="player" />

                            <span class="roster-identity">
                                <span class="roster-name">@player.Name</span>
                                <span class="roster-subline @(hasPosition ? "" : "is-unset")">
                                    @(hasPosition ? player.PrimaryPosition.ToDisplayName(Loc) : Loc["playerItem.setPosition"])
                                </span>
                            </span>

                            @* One overall cluster stands in for the three skills, with the
                               breakdown on the tooltip - the same rating the player rows on
                               the other screens show. *@
                            <span class="roster-rating"
                                  title="@(Loc["playerItem.skillsTitle", player.Speed, player.TechnicalSkills, player.Stamina])">
                                <SkillRatingDisplay Rating="@((int)Math.Round(player.OverallSkillLevel, MidpointRounding.AwayFromZero))" />
                            </span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>
