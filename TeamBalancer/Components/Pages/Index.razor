@page "/"
@inherits LocalizedComponentBase

<LayoutSection Section="Header">
    <div class="header-with-menu">
        @* The language button takes the place the spacer used to hold, so the title stays
           centred between it and the menu button. *@
        <button class="menu-button" @onclick="ToggleLanguageMenu" title="@(Loc["language.title"])" aria-label="@(Loc["language.title"])">
            <i class="fas fa-globe"></i>
        </button>
        <h1 class="header-title-centered">@Loc["app.title"]</h1>
        <button class="menu-button" @onclick="ToggleMenu" title="@(Loc["common.menu"])">
            <i class="fas fa-ellipsis-v"></i>
        </button>
    </div>
</LayoutSection>

<LayoutSection Section="Footer">
    <div class="footer-buttons">
        <button class="btn btn-icon btn-secondary" @onclick="AddPlayer" title="@(Loc["home.addPlayer"])" aria-label="@(Loc["home.addPlayer"])">
            <i class="fas fa-plus"></i>
        </button>
        <button class="btn btn-success" @onclick="CreateTeams" disabled="@(!CanCreateTeams)">@Loc["common.createTeams"]</button>
    </div>
</LayoutSection>

@if (_showLanguageMenu)
{
    <div class="menu-overlay menu-overlay-start" @onclick="ToggleLanguageMenu">
        <div class="menu-popup" @onclick:stopPropagation="true">
            <div class="menu-header">
                <h3>@Loc["language.title"]</h3>
                <button class="close-button" @onclick="ToggleLanguageMenu">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="menu-items">
                @foreach (var language in Loc.SupportedLanguages)
                {
                    var option = language;
                    var isCurrent = option.Code == Loc.CurrentLanguage;
                    <button class="menu-item @(isCurrent ? "is-selected" : "")" @onclick="() => SelectLanguage(option.Code)">
                        @* The tick shares the icon column with the other menus, so the rows
                           line up whether or not this is the active language. *@
                        <i class="fas @(isCurrent ? "fa-check" : "")"></i>
                        <span>@option.NativeName</span>
                    </button>
                }
            </div>
        </div>
    </div>
}

@if (_showMenu)
{
    <div class="menu-overlay" @onclick="ToggleMenu">
        <div class="menu-popup" @onclick:stopPropagation="true">
            <div class="menu-header">
                <h3>@Loc["common.menu"]</h3>
                <button class="close-button" @onclick="ToggleMenu">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="menu-items">
                <button class="menu-item" @onclick="ExportPlayers">
                    <i class="fas fa-upload"></i>
                    <span>@Loc["home.exportPlayers"]</span>
                </button>
                <label class="menu-item">
                    <i class="fas fa-download"></i>
                    <span>@Loc["home.importPlayers"]</span>
                    <InputFile OnChange="ImportPlayers" accept=".csv,text/csv,text/comma-separated-values,application/csv" style="display: none;" />
                </label>
            </div>
        </div>
    </div>
}

<div class="index-container">
    <div class="index-content">
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success")">
                @_message
            </div>
        }

        <div class="field-image">
            <svg class="pitch-graphic" viewBox="0 0 18 28" preserveAspectRatio="xMidYMid meet" fill="none" stroke="#ffffff" stroke-width="0.4" stroke-linejoin="round" stroke-linecap="round">
                <rect x="1" y="1" width="16" height="26" rx="0.6" fill="#2e8b3d"></rect>
                <line x1="1" y1="14" x2="17" y2="14"></line>
                <circle cx="9" cy="14" r="3.2"></circle>
                <circle cx="9" cy="14" r="0.5" fill="#ffffff" stroke="none"></circle>
                <rect x="4" y="1" width="10" height="5"></rect>
                <rect x="6.5" y="1" width="5" height="2"></rect>
                <rect x="4" y="22" width="10" height="5"></rect>
                <rect x="6.5" y="25" width="5" height="2"></rect>
                <circle cx="9" cy="2.2" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="4.3" cy="5.5" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="9" cy="5.5" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="13.7" cy="5.5" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="5" cy="9" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="9" cy="9" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="13" cy="9" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="9" cy="12" r="0.55" fill="#3b82f6" stroke="none"></circle>
                <circle cx="9" cy="25.8" r="0.55" fill="#ef4444" stroke="none"></circle>
                <circle cx="3.3" cy="22" r="0.55" fill="#ef4444" stroke="none"></circle>
                <circle cx="7.2" cy="22.6" r="0.55" fill="#ef4444" stroke="none"></circle>
                <circle cx="10.8" cy="22.6" r="0.55" fill="#ef4444" stroke="none"></circle>
                <circle cx="14.7" cy="22" r="0.55" fill="#ef4444" stroke="none"></circle>
                <circle cx="6.5" cy="18.3" r="0.55" fill="#ef4444" stroke="none"></circle>
                <circle cx="11.5" cy="18.3" r="0.55" fill="#ef4444" stroke="none"></circle>
                <circle cx="9" cy="15.3" r="0.55" fill="#ef4444" stroke="none"></circle>
            </svg>
        </div>
    </div>
</div>
