@page "/teams"
@using TeamBalancer.Components.Shared
@using TeamBalancer.Extensions

<LayoutSection Section="Header">
    <div class="header-with-back">
        <button class="back-button" @onclick="GoHome" title="Back">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <h1 class="header-title-left">Teams</h1>
    </div>
</LayoutSection>

@if (GeneratedTeams != null && GeneratedTeams.Any())
{
    <LayoutSection Section="Footer">
        <div class="button-group">
            <button class="btn btn-success" @onclick="ReshuffleTeams">Reshuffle</button>
            <button class="btn btn-secondary" @onclick="GoHome">Home</button>
        </div>
    </LayoutSection>
}

<div class="page-container">
    <div class="page-content-narrow">

        @if (GeneratedTeams == null || !GeneratedTeams.Any())
        {
            <div class="no-teams text-center card-padding">
                <p>No teams have been created yet.</p>
                <button class="btn btn-primary" @onclick="GoToCreateTeams">Create Teams</button>
            </div>
        }
        else
        {
            @* Teams can be regenerated underneath us, so never trust the stored index blindly. *@
            var activeIndex = Math.Clamp(_activeTabIndex, 0, GeneratedTeams.Count - 1);
            var activeTeam = GeneratedTeams[activeIndex];

            <div class="seg team-tabs" role="tablist">
                @for (var i = 0; i < GeneratedTeams.Count; i++)
                {
                    var index = i;
                    <button type="button"
                            role="tab"
                            aria-selected="@(index == activeIndex)"
                            class="seg-opt @TeamColorClass(index) @(index == activeIndex ? "is-selected" : "")"
                            @onclick="() => _activeTabIndex = index">
                        @GeneratedTeams[index].Name
                    </button>
                }
            </div>

            @if (GeneratedTeams.Count == 2)
            {
                <div class="balance-card">
                    <div class="card-kicker">Balance comparison</div>

                    @foreach (var metric in GetBalanceMetrics(GeneratedTeams[0], GeneratedTeams[1]))
                    {
                        <div class="balance-row">
                            <span class="balance-label">@metric.Label</span>
                            <div class="balance-bars">
                                <div class="balance-track">
                                    <div class="balance-fill team-a"
                                         style="width:@Percent(metric.LeftValue)"
                                         title="@GeneratedTeams[0].Name @metric.Label: @metric.LeftValue.ToString("F2")"></div>
                                </div>
                                <div class="balance-track">
                                    <div class="balance-fill team-b"
                                         style="width:@Percent(metric.RightValue)"
                                         title="@GeneratedTeams[1].Name @metric.Label: @metric.RightValue.ToString("F2")"></div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="balance-legend">
                        @for (var i = 0; i < 2; i++)
                        {
                            var team = GeneratedTeams[i];
                            <div class="legend-slot">
                                <span class="legend-tag @TeamColorClass(i)"
                                      title="@team.Name overall rating: @Overall(team).ToString("F2")">
                                    <span class="legend-name">@team.Name</span>
                                    <span class="legend-rating">@Overall(team).ToString("F1")</span>
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="position-tiles @TeamColorClass(activeIndex)">
                @foreach (var entry in GetPositionSummary(activeTeam))
                {
                    <div class="position-tile @(entry.Count == 0 ? "is-empty" : "")" title="@entry.Title">
                        <span class="tile-count">@entry.Count</span>
                        <span class="tile-label">@entry.Label</span>
                    </div>
                }
            </div>

            @if (activeTeam.Players.Count == 0)
            {
                <p class="no-players-hint text-center text-muted">No players on this team.</p>
            }
            else
            {
                <div class="team-players @TeamColorClass(activeIndex)">
                    @foreach (var player in activeTeam.Players.OrderByDescending(p => p.OverallSkillLevel))
                    {
                        <PlayerItem Player="@player" IsSelected="false" ShowCheckbox="false" />
                    }
                </div>
            }
        }
    </div>
</div>
