@page "/teams"
@using TeamBalancer.Components.Shared

<LayoutSection Section="Header">
    <h1 class="header-title-centered">Teams</h1>
</LayoutSection>

@if (GeneratedTeams != null && GeneratedTeams.Any())
{
    <LayoutSection Section="Footer">
        <div class="button-group">
            <button class="btn btn-success" @onclick="ReshuffleTeams">Reshuffle</button>
            <button class="btn btn-secondary" @onclick="GoHome">Home</button>
        </div>
    </LayoutSection>
}

<div class="page-container">
    <div class="page-content-narrow">

        @if (GeneratedTeams == null || !GeneratedTeams.Any())
        {
            <div class="no-teams text-center card-padding">
                <p>No teams have been created yet.</p>
                <button class="btn btn-primary" @onclick="GoToCreateTeams">Create Teams</button>
            </div>
        }
        else
        {
            <div class="tabs-container">
                <div class="tabs-header">
                    @{ var tabIndex = 0; }
                    @foreach (var team in GeneratedTeams)
                    {
                        var currentTabIndex = tabIndex;
                        var teamColorClass = tabIndex % 2 == 0 ? "team-red" : "team-green";
                        <button class="tab-button @(currentTabIndex == _activeTabIndex ? "active" : "") @teamColorClass"
                                @onclick="() => _activeTabIndex = currentTabIndex">
                            @team.Name
                        </button>
                        tabIndex++;
                    }
                </div>

                <div class="tab-content">
                    @{ var contentIndex = 0; }
                    @foreach (var team in GeneratedTeams)
                    {
                        var currentContentIndex = contentIndex;
                        var teamColorClass = contentIndex % 2 == 0 ? "team-red" : "team-green";
                        <div class="tab-pane @(currentContentIndex == _activeTabIndex ? "active" : "")">
                            <div class="team-section card">
                                <div class="team-header @teamColorClass">
                                    <h2>@team.Name</h2>
                                    <div class="team-summary">
                                        <span class="player-count">@team.PlayerCount players</span>
                                        <span class="overall-skill">Overall: @team.OverallTeamSkill.ToString("F2")</span>
                                    </div>
                                </div>

                                <div class="team-stats-grid">
                                    <div class="team-stat">
                                        <span class="stat-label">Speed</span>
                                        <span class="stat-value">@team.AverageSpeed.ToString("F2")</span>
                                    </div>
                                    <div class="team-stat">
                                        <span class="stat-label">Technical</span>
                                        <span class="stat-value">@team.AverageTechnicalSkills.ToString("F2")</span>
                                    </div>
                                    <div class="team-stat">
                                        <span class="stat-label">Stamina</span>
                                        <span class="stat-value">@team.AverageStamina.ToString("F2")</span>
                                    </div>
                                </div>

                                <div class="team-players">
                                    @foreach (var player in team.Players.OrderByDescending(p => p.OverallSkillLevel))
                                    {
                                        <PlayerItem Player="@player" IsSelected="false" ShowCheckbox="false" />
                                    }
                                </div>
                            </div>
                        </div>
                        contentIndex++;
                    }
                </div>
            </div>
        }
    </div>
</div>
