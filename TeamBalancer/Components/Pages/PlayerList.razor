@page "/create-teams"
@using TeamBalancer.Core.Models
@using TeamBalancer.Core.Services.Balancing
@using TeamBalancer.Components.Shared

<LayoutSection Section="Header">
    <h1 class="header-title-centered">Select Players</h1>
</LayoutSection>

<LayoutSection Section="Footer">
    <div class="button-group">
        @if (_players.Any() && !_isLoading)
        {
            <button class="btn btn-success" @onclick="CreateTeams" disabled="@NoPlayersSelected">Create</button>
        }
        <button class="btn btn-primary btn-icon" @onclick="GoToAddPlayer"><i class="fas fa-plus"></i></button>
        <button class="btn btn-secondary" @onclick="Cancel">Home</button>
    </div>
</LayoutSection>

<div class="page-container-playerlist">
    @if (_isLoading)
    {
        <div class="loading text-center text-muted card-padding">Loading players...</div>
    }
    else if (!_players.Any())
    {
        <div class="no-players text-center card-padding">
            <p class="mb-2">No players available. Please add players first.</p>
        </div>
    }
    else
    {
        <div class="selection-info-container">
            <p>Selected: @_selectedPlayerIds.Count / @_players.Count players</p>
        </div>

        <div class="player-list-wrapper">
            <SelectablePlayerList Players="_players" SelectedPlayerIds="_selectedPlayerIds" ShowEditButton="true"
                ShowDeleteButton="true" OnPlayerSelectionChanged="HandlePlayerSelectionChanged"
                OnSelectAllPlayersChanged="HandleSelectAllChanged" OnPlayerEdit="HandlePlayerEdit"
                OnPlayerDelete="HandlePlayerDelete" />
        </div>
    }
</div>

@if (_showDeleteConfirm)
{
    <div class="confirm-overlay" @onclick="CancelDelete">
        <div class="confirm-dialog" @onclick:stopPropagation="true">
            <div class="confirm-header">
                <h3>Team Balancer</h3>
            </div>
            <div class="confirm-body">
                <p>Are you sure you want to delete <strong>@_playerToDelete?.Name</strong>?</p>
                <p class="confirm-warning">This action cannot be undone.</p>
            </div>
            <div class="confirm-footer">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmDeletePlayer">Delete</button>
            </div>
        </div>
    </div>
}