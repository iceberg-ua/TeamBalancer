<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TeamBalancer"
             xmlns:components="clr-namespace:TeamBalancer.Components"
             x:Class="TeamBalancer.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1b6ec2">

    <Grid RowDefinitions="Auto,*">
        <!-- Status bar spacer - height set in code-behind for Android -->
        <BoxView x:Name="StatusBarSpacer"
                 Grid.Row="0"
                 Color="#1b6ec2"
                 HeightRequest="0" />

        <BlazorWebView Grid.Row="1"
                       x:Name="blazorWebView"
                       HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
