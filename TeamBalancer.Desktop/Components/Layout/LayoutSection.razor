@implements IDisposable

@code {
    [CascadingParameter]
    public MainLayout? Layout { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Section { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        if (Layout != null && ChildContent != null)
        {
            if (Section.Equals("Header", StringComparison.OrdinalIgnoreCase))
            {
                Layout.SetHeader(ChildContent);
            }
            else if (Section.Equals("Footer", StringComparison.OrdinalIgnoreCase))
            {
                Layout.SetFooter(ChildContent);
            }
        }
    }

    public void Dispose()
    {
        if (Layout != null)
        {
            if (Section.Equals("Header", StringComparison.OrdinalIgnoreCase))
            {
                Layout.SetHeader(null!);
            }
            else if (Section.Equals("Footer", StringComparison.OrdinalIgnoreCase))
            {
                Layout.SetFooter(null!);
            }
        }
    }
}
